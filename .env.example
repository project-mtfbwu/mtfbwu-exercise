# Environment example — copy to .env.local for development.
# Never commit real secrets.

# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_BUILD_SHA=local-dev
NEXT_PUBLIC_RELEASE_VERSION=0.1.0-beta.1

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
USDA_FDC_API_KEY=your-usda-fdc-api-key
OPEN_FOOD_FACTS_USER_AGENT=MTFBWU/0.1.0 (dev@example.com)

# Optional operations
# ERROR_MONITORING_DSN=
RATE_LIMIT_BACKEND=memory
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_ALLOW_MEMORY_IN_PRODUCTION=false
# PRIVATE_BETA_MODE=false
# PRIVATE_BETA_ALLOWLIST=you@example.com
# SUPPORT_EMAIL=support@example.com
# FEATURE_BARCODE=true
# FEATURE_OCR=true
# FEATURE_PROGRESS_CAMERA=true
# FEATURE_ACCOUNT_EXPORT=true
# FEATURE_ACCOUNT_DELETION=true
