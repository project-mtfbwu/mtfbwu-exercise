    "backup:local": "node ./scripts/backup-local.mjs",
    "restore:local": "node ./scripts/restore-local.mjs",
    "verify:restore": "node ./scripts/verify-restore.mjs",
    "seed:recovery-drill": "node ./scripts/seed-recovery-drill.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
